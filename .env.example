# 投資失敗録 環境変数サンプル
# このファイルを .env にコピーして、本番値を入れてください
# .env は .gitignore で除外されています

# microCMS（後で連携時に必要・現状は仮データで動作）
MICROCMS_SERVICE_DOMAIN=toushishippairoku
MICROCMS_API_KEY=PLACEHOLDER_REPLACE_ME

# Google Analytics 4（公開後）
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# サイト URL（astro.config.mjs と一致させる）
SITE_URL=https://toushi-shippai-roku.com
