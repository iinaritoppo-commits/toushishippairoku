---
import SEO from "../components/SEO.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** クイックナビを表示するか（個別記事ページではfalseでもいい） */
  showQuickNav?: boolean;
  pageType?: "website" | "article";
  articleMeta?: {
    headline?: string;
    datePublished?: string;
    dateModified?: string;
    author?: string;
    category?: string;
  };
  breadcrumbs?: { name: string; url: string }[];
}

const { title, description, image, showQuickNav = true, pageType, articleMeta, breadcrumbs } = Astro.props;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />

  <meta name="google-adsense-account" content="ca-pub-6137725398672331" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700;900&family=Noto+Serif+JP:wght@700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700;900&family=Noto+Serif+JP:wght@700&display=swap" rel="stylesheet" /></noscript>
  <SEO title={title} description={description} image={image} pageType={pageType} articleMeta={articleMeta} breadcrumbs={breadcrumbs} />

  {/* GA4 + AdSense は LCP後に遅延ロード（Performance最大化）— GA4 IDはとよくん取得後差し替え */}
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    window.gtag = gtag;
    gtag('js', new Date());
    gtag('config', 'G-GD0BQWTZRS', { send_page_view: true });
    window.addEventListener('load', () => {
      setTimeout(() => {
        const ga = document.createElement('script');
        ga.async = true;
        ga.src = 'https://www.googletagmanager.com/gtag/js?id=G-GD0BQWTZRS';
        document.head.appendChild(ga);
        const ads = document.createElement('script');
        ads.async = true;
        ads.crossOrigin = 'anonymous';
        ads.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6137725398672331';
        document.head.appendChild(ads);

        // === カスタムイベント追跡 ===
        // 1) スクロール深度（25/50/75%）
        const sent = new Set();
        let ticking = false;
        const checkDepth = () => {
          const h = document.documentElement;
          const pct = ((h.scrollTop + window.innerHeight) / h.scrollHeight) * 100;
          [25, 50, 75].forEach(d => {
            if (pct >= d && !sent.has(d)) {
              sent.add(d);
              gtag('event', 'scroll_depth', { value: d, page_path: location.pathname });
            }
          });
          ticking = false;
        };
        document.addEventListener('scroll', () => {
          if (!ticking) { requestAnimationFrame(checkDepth); ticking = true; }
        }, { passive: true });

        // 2) クリック委任：アフィリ / シェア / 外部リンク
        document.addEventListener('click', (e) => {
          const t = e.target.closest('a');
          if (!t) return;
          if (t.hasAttribute('data-aff')) {
            gtag('event', 'affiliate_click', {
              link_url: t.href || '',
              link_text: (t.textContent || '').trim().slice(0, 50),
              aff_slot: t.getAttribute('data-aff') || '',
            });
          } else if (t.hasAttribute('data-share')) {
            gtag('event', 'share_click', { method: t.getAttribute('data-share') });
          } else if (t.href && t.host && t.host !== location.host && /^https?:/.test(t.href)) {
            gtag('event', 'outbound_click', { link_url: t.href, link_text: (t.textContent || '').trim().slice(0, 50) });
          }
        }, true);

        // 3) 投稿フォーム閲覧・送信
        const form = document.querySelector('form[data-track="submit"]');
        if (form) {
          const io = new IntersectionObserver(es => {
            es.forEach(en => { if (en.isIntersecting) { gtag('event', 'submit_form_view'); io.disconnect(); } });
          }, { threshold: 0.5 });
          io.observe(form);
          form.addEventListener('submit', () => gtag('event', 'submit_form_submit'));
        }
      }, 1500);
    });
  </script>
</head>
<body>
  <header class="site-header">
    <div class="site-header__inner">
      <a class="brand" href="/">
        <span class="brand__mark">投</span>
        <span>
          <span class="brand__sub">TOUSHI-SHIPPAI-ROKU</span>
          <span class="brand__title">投資失敗録</span>
        </span>
      </a>
      <nav class="nav">
        <a href="/category/fx/">FX</a>
        <a href="/category/stocks/">株</a>
        <a href="/category/crypto/">仮想</a>
        <a href="/category/realestate/">不動産</a>
        <a href="/category/funds/">投信</a>
        <a href="/category/fraud/">詐欺</a>
        <a href="/search/" aria-label="検索"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="vertical-align:middle"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></a>
        <a href="/about/">運営</a>
      </nav>
    </div>
  </header>

  {showQuickNav && (
    <nav class="quick-nav">
      <div class="quick-nav__inner">
        <span class="quick-nav__label">EXPLORE</span>
        <a href="/#section-loss">金額別</a>
        <a href="/#section-latest">最新</a>
        <a href="/#section-cats">ジャンル</a>
        <a href="/#section-map">全国マップ</a>
        <a href="/kuyou/">失敗供養所</a>
        <a href="/#section-moments">気づいた瞬間</a>
        <a href="/#section-diary">編集ノート</a>
        <a href="/submit/" class="quick-nav__submit">投稿する →</a>
      </div>
    </nav>
  )}

  <main>
    <slot />
  </main>

  <footer class="foot">
    <div class="foot__sister">
      <span class="foot__sister-label">姉妹サイト：</span>
      <a href="https://kaidanroku.com/" target="_blank" rel="noopener">怪談録</a>
      <span class="foot__sister-sep">・</span>
      <a href="https://fukugyousagiroku.com/" target="_blank" rel="noopener">副業詐欺録</a>
      <span class="foot__sister-note">（同じ運営「しら」によるアーカイブ）</span>
    </div>
    <div>© 2026 投資失敗録 ・ 編集：しら ・ <a href="/about/">編集者</a> ・ <a href="/policy/">編集方針</a> ・ <a href="/disclaimer/">免責事項</a> ・ <a href="/privacy/">プライバシー</a></div>
    <div class="foot__legal">本サイトは金融商品取引業者ではありません。掲載内容は投資助言・推奨ではなく、実話の記録です。投資判断は自己責任でお願いします。</div>
  </footer>

  {/* ===== スマホ下部固定ナビ ===== */}
  <nav class="bottom-nav" aria-label="モバイルナビ">
    <a href="/" class="bottom-nav__item">
      <svg class="bottom-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12 12 3l9 9"/><path d="M5 10v10h14V10"/></svg>
      <span>新着</span>
    </a>
    <a href="/#section-cats" class="bottom-nav__item">
      <svg class="bottom-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
      <span>ジャンル</span>
    </a>
    <a href="/submit/" class="bottom-nav__item bottom-nav__item--accent">
      <svg class="bottom-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
      <span>投稿</span>
    </a>
    <a href="/search/" class="bottom-nav__item">
      <svg class="bottom-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <span>検索</span>
    </a>
  </nav>

  <style is:global>
    .foot__sister { padding:14px 18px; background:#f8f5ec; border:1px solid #e0d8c0; border-radius:6px; margin-bottom:14px; font-size:0.92rem; }
    .foot__sister-label { color:#5a6070; font-weight:600; margin-right:6px; }
    .foot__sister a { color:#b8312a; text-decoration:none; }
    .foot__sister a:hover { text-decoration:underline; }
    .foot__sister-sep { color:#aab0b8; margin:0 8px; }
    .foot__sister-note { color:#7a8595; margin-left:10px; font-size:0.85rem; }
  </style>

  {/* Cookie 同意バナー */}
  <div id="cookie-banner" class="cookie-banner" hidden>
    <div class="cookie-banner__inner">
      <p>このサイトでは、アクセス解析と広告のため Cookie を使用しています。詳しくは <a href="/privacy/">プライバシーポリシー</a> をご覧ください。</p>
      <div class="cookie-banner__btns">
        <button class="cookie-banner__btn cookie-banner__btn--accept" data-consent="accept">同意する</button>
        <button class="cookie-banner__btn cookie-banner__btn--decline" data-consent="decline">利用しない</button>
      </div>
    </div>
  </div>
  <script is:inline>
    (function() {
      var KEY = 'cookie-consent';
      var stored = localStorage.getItem(KEY);
      var banner = document.getElementById('cookie-banner');
      function apply(choice) {
        if (window.gtag) {
          window.gtag('consent', 'update', {
            ad_storage: choice === 'accept' ? 'granted' : 'denied',
            analytics_storage: choice === 'accept' ? 'granted' : 'denied',
          });
        }
      }
      if (!stored && banner) {
        banner.hidden = false;
        banner.addEventListener('click', function(e) {
          var btn = e.target.closest('[data-consent]');
          if (!btn) return;
          var choice = btn.getAttribute('data-consent');
          localStorage.setItem(KEY, choice);
          banner.hidden = true;
          apply(choice);
        });
      } else if (stored) {
        apply(stored);
      }
    })();
  </script>
  <style is:global>
    .cookie-banner { position: fixed; bottom: 0; left: 0; right: 0; background: #1a2f4e; color: #fff; padding: 16px 20px; z-index: 9999; box-shadow: 0 -4px 16px rgba(0,0,0,0.3); }
    .cookie-banner__inner { max-width: 960px; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; gap: 16px; justify-content: space-between; }
    .cookie-banner p { margin: 0; font-size: 0.88rem; line-height: 1.6; flex: 1 1 280px; color: #fff; }
    .cookie-banner a { color: #c89a4a; text-decoration: underline; }
    .cookie-banner__btns { display: flex; gap: 10px; flex-shrink: 0; }
    .cookie-banner__btn { padding: 8px 18px; font-size: 0.85rem; cursor: pointer; border: 1px solid; background: transparent; color: #fff; font-family: inherit; }
    .cookie-banner__btn--accept { background: #c89a4a; border-color: #c89a4a; color: #1a2f4e; font-weight: 600; }
    .cookie-banner__btn--decline { border-color: #888; color: #ccc; }
    @media (max-width: 640px) {
      .cookie-banner { padding: 10px 14px; }
      .cookie-banner__inner { flex-direction: column; align-items: stretch; gap: 8px; }
      .cookie-banner p { font-size: 0.76rem; line-height: 1.5; }
      .cookie-banner__btns { justify-content: stretch; gap: 8px; }
      .cookie-banner__btn { flex: 1; padding: 8px; }
    }
  </style>
</body>
</html>
