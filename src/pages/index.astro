        <span class="home-pillar-card__arrow" aria-hidden="true">→</span>
      </div>
    </a>
  ))}
</div>

</main>

<JapanMap />

<a href="/kuyou/" class="kuyou-banner">
  <div class="kuyou-banner__text">
    <span class="kuyou-banner__sub">SHIPPAI KUYOUJO</span>
    <span class="kuyou-banner__title">失敗供養所</span>
    <span class="kuyou-banner__lead">届いた話をひとつずつ供養する場所。戒名つき。毎月17日にお焚き上げ。</span>
  </div>
  <span class="kuyou-banner__cta">入る →</span>
</a>


<main class="container">

<header class="section-h" id="section-explain">
  <div class="section-h__title-group">
    <span class="section-h__sub">EXPLAIN</span>
    <h2 class="section-h__title">仕組みから読む</h2>
  </div>
  <a href="/explain/" class="section-h__more">すべての解説を見る →</a>
</header>
<div class="home-pillar-grid">
  {EXPLAINS.map((e) => (
    <a href={e.href} class={`home-pillar-card home-pillar-card--${e.accent ?? "navy"}`}>
      <div class="home-pillar-card__head">
        <span class="home-pillar-card__cat">{e.category}</span>
      </div>
      <h3 class="home-pillar-card__title">{e.shortTitle}</h3>
      <p class="home-pillar-card__desc">{e.description.slice(0, 88)}…</p>
      <div class="home-pillar-card__foot">
        <span>続きを読む</span>
        <span class="home-pillar-card__arrow" aria-hidden="true">→</span>
      </div>
    </a>
  ))}
</div>


<header class="section-h"><div class="section-h__title-group"><span class="section-h__sub">EDITOR</span><h2 class="section-h__title">編集者について</h2></div></header>
<div class="operator">
  <div class="operator__avatar">しら</div>
  <div>
    <h3 class="operator__name">しら</h3>
    <p class="operator__role">EDITOR / 編集</p>
    <p class="operator__bio">
      普段は別の仕事をしながら、チャートの読み方を学んでいます。自分も、含み損をふくらませて退場したことが何度もありました。<br/>
      勝ち方を語るには、まだ早い。それでも、聞いた失敗を地図にして残すことなら、できると思いました。<br/>
      投稿で届いた話と、仕事中にぽろっと打ち明けられた話を、編集して置いています。<br/>
      <strong>投資助言は一切行いません。</strong>やるのは、事実の記録と、起きた構造の整理です。
    </p>
  </div>
</div>

<section class="submit-cta" id="section-submit">
  <div class="submit-cta__sub">SUBMIT YOUR STORY</div>
  <h2 class="submit-cta__title">あなたの失敗を、聞かせてください。</h2>
  <p class="submit-cta__lead">匿名で投稿できます。仮名・地名ぼかしの条件で構いません。<br/>連絡先を残してくださった方には、必要に応じてメールで簡単なやり取りをします。</p>
  <a href="/submit/" class="submit-cta__btn">投稿フォームへ ›</a>
</section>

</main>

<script is:inline>
  let shoukouCount = 0;
  let soundOn = true;
  let audioCtx = null;

  function ensureAudio() {
    if (!audioCtx) {
      const AC = window.AudioContext || window.webkitAudioContext;
      if (AC) audioCtx = new AC();
    }
    return audioCtx;
  }

  function playPop() {
    const ctx = ensureAudio();
    if (!ctx) return;
    if (ctx.state === 'suspended') ctx.resume();
    const t = ctx.currentTime;
    const osc = ctx.createOscillator();
    const og = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(120, t);
    osc.frequency.exponentialRampToValueAtTime(45, t + 0.18);
    og.gain.setValueAtTime(0.0001, t);
    og.gain.exponentialRampToValueAtTime(0.42, t + 0.005);
    og.gain.exponentialRampToValueAtTime(0.0001, t + 0.28);
    osc.connect(og).connect(ctx.destination);
    osc.start(t); osc.stop(t + 0.32);
    const noiseDur = 0.08;
    const buf = ctx.createBuffer(1, Math.floor(ctx.sampleRate * noiseDur), ctx.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / data.length, 2);
    const noise = ctx.createBufferSource();
    noise.buffer = buf;
    const ng = ctx.createGain();
    ng.gain.setValueAtTime(0.18, t);
    ng.gain.exponentialRampToValueAtTime(0.0001, t + 0.07);
    const filter = ctx.createBiquadFilter();
    filter.type = 'lowpass';
    filter.frequency.setValueAtTime(420, t);
    noise.connect(filter).connect(ng).connect(ctx.destination);
    noise.start(t); noise.stop(t + noiseDur);
  }

  window.shoukou = function () {
    shoukouCount++;
    const sEl = document.getElementById('altar-count-shoukou');
    if (sEl) sEl.innerHTML = shoukouCount.toLocaleString() + '<span class="altar__count-suffix">回</span>';
    if (soundOn) playPop();
    const ack = document.getElementById('shoukou-ack');
    if (ack) {
      ack.classList.remove('show');
      void ack.offsetWidth;
      ack.classList.add('show');
      setTimeout(function () { ack.classList.remove('show'); }, 1800);
    }
  };

  document.getElementById('sound-on')?.addEventListener('change', function (e) {
    soundOn = e.target.checked;
    document.getElementById('sound-label').textContent = soundOn ? '音 ON' : '音 OFF';
  });
</script>

</BaseLayout>
