    pros: [
      "ロスカット水準が50%で執行までの余裕が大きい",
      "取引ツールが分かりやすく初学者でも操作しやすい",
      "LINEサポートで24時間問い合わせ可能",
    ],
    cons: [
      "10,000通貨単位なので、月1万円以内のお試しには向かない",
      "ロスカット50%＝余裕がある分、損失自体は膨らみやすい",
    ],
    pickFor: "週1-2回・10万円以上の証拠金で動かしたい人",
    ctaText: "DMM FX 公式サイト",
    ctaHref: "https://px.a8.net/svt/ejp?a8mat=3BDQIZ+6C130I+1WP2+6IWSI",
    ctaNote: "※PRリンク。最新の取引条件・ロスカット仕様は公式サイトで確認を",
  },
  {
    name: "GMOクリック証券 FXネオ",
    tagline: "国内取引高No.1クラスの約定力。短期売買とスキャル中心の人に。",
    badge: "編集者観察",
    specs: [
      { label: "ロスカット水準", value: "証拠金維持率 50%以下", highlight: true },
      { label: "最低取引単位", value: "10,000通貨" },
      { label: "USD/JPYスプレッド", value: "0.2銭（原則固定）" },
      { label: "口座開設費", value: "無料" },
    ],
    pros: [
      "約定力が安定していて、指標発表時のスリッページも比較的小さい傾向",
      "板情報・ニュース配信が標準装備",
      "ロスカット水準50%で余裕大",
    ],
    cons: [
      "ツール画面が情報量多めで初学者は最初戸惑う",
      "10,000通貨単位",
    ],
    pickFor: "短期売買中心・約定力を最優先する人",
  },
  {
    name: "マネックス証券 FX PLUS",
    tagline: "ロスカット水準を50〜100%で自分で選べる。1,000通貨で少額からも。",
    badge: "編集者観察",
    specs: [
      { label: "ロスカット水準", value: "50/60/70/100%から選択（初期100%）", highlight: true },
      { label: "最低取引単位", value: "1,000通貨" },
      { label: "USD/JPYスプレッド", value: "0.2銭（原則固定・例外あり）" },
      { label: "口座開設費", value: "無料" },
    ],
    pros: [
      "ロスカット水準を50/60/70/100%の4段階から自分で設定できる（多くの他社は固定）",
      "1,000通貨単位で、月数千円の証拠金から始められる",
      "取引手数料・口座開設・維持費すべて0円",
    ],
    cons: [
      "利用には証券総合取引口座とFX PLUS口座の2つ開設が必要",
      "初期設定がロスカット100%＝そのままだと早めに切られる（自分で調整する前提）",
    ],
    pickFor: "ロスカット水準を自分で決めたい人・1,000通貨で少額から試したい人",
    ctaText: "マネックス証券 FX PLUS 公式サイト",
    ctaHref: "https://h.accesstrade.net/sp/cc?rk=0100pldr00ou39",
    ctaNote: "※PRリンク。最新の取引条件・ロスカット仕様は公式サイトで確認を",
  },
  {
    name: "外為どっとコム",
    tagline: "1,000通貨単位＋情報量が多い老舗。初学者の最初の口座に向く。",
    badge: "編集者観察",
    specs: [
      { label: "ロスカット水準", value: "証拠金維持率 100%以下", highlight: true },
      { label: "最低取引単位", value: "1,000通貨" },
      { label: "USD/JPYスプレッド", value: "0.2銭（原則固定）" },
      { label: "口座開設費", value: "無料" },
    ],
    pros: [
      "1,000通貨単位なので月数千円の証拠金から練習できる",
      "セミナー・レポート・コラムなど学習コンテンツが豊富",
      "ロスカット100%で早期執行＝追証が起きにくい",
    ],
    cons: [
      "ロスカット100%は「保有期間の余裕が短い」とも言える",
      "ツールUIがやや古めという声がある",
    ],
    pickFor: "1,000通貨で少額から始めたい初学者",
  },
  {
    name: "LINE FX",
    tagline: "LINE通知ベースでスマホ完結。1,000通貨単位で気軽さ重視。",
    badge: "編集者観察",
    specs: [
      { label: "ロスカット水準", value: "証拠金維持率 100%以下", highlight: true },
      { label: "最低取引単位", value: "1,000通貨" },
      { label: "USD/JPYスプレッド", value: "0.2銭（原則固定）" },
      { label: "口座開設費", value: "無料" },
    ],
    pros: [
      "経済指標・為替変動をLINEで通知してくれる（見逃しにくい）",
      "口座開設からトレードまでスマホ完結",
      "1,000通貨単位＆ロスカット100%",
    ],
    cons: [
      "PCツールはGMO系で同じものが多く、独自性は薄め",
      "LINE通知に依存しすぎると判断が鈍るリスク",
    ],
    pickFor: "スマホ完結派・通知ドリブンで動きたい人",
  },
  {
    name: "マネーパートナーズ（PartnersFX nano)",
    tagline: "100通貨単位でガチ少額。練習口座としてだけ持つ選択肢もあり。",
    badge: "編集者観察",
    specs: [
      { label: "ロスカット水準", value: "証拠金維持率 100%以下", highlight: true },
      { label: "最低取引単位", value: "100通貨" },
      { label: "USD/JPYスプレッド", value: "0.3銭（原則固定）" },
      { label: "口座開設費", value: "無料" },
    ],
    pros: [
      "100通貨単位は国内最少クラス。月数百円からの練習が可能",
      "ロスカット100%＋少額単位で「練習中は追証発生し得ない」レベル",
    ],
    cons: [
      "スプレッドが他社よりやや広い",
      "本格運用にはツールがシンプルすぎるとの声もある",
    ],
    pickFor: "本番に進む前の練習口座として、ゼロ円リスクで仕様を理解したい人",
  },
];

// 失敗体験への内部リンク
const relatedFailures = [
  {
    href: "/articles/fx-380man/",
    title: "380万円が3分で消えた話 ─ FX指標発表での全損",
    meta: "30代男性・FX・指標発表",
  },
  {
    href: "/articles/toushi-fx-001/",
    title: "ロスカットを下げた、その夜のことだった",
    meta: "30代男性・FX・200万円台",
  },
];

// 末尾の同種ピラー & 失敗体験ミックス
const endSameCategory = relatedFailures.map((r) => ({
  href: r.href,
  title: r.title,
  meta: r.meta,
}));
const endPillars = [
  {
    href: "/compare/asset-expo-warning/",
    title: "資産運用EXPOに行ったらアカン理由",
    meta: "Xトレンド分析＋構造解説（2026最新）",
  },
  {
    href: "/explain/loss-cut-mechanism/",
    title: "ロスカットの仕組み 完全解説",
    meta: "「指定レート」と「次の約定可能レート」の差",
  },
];

const breadcrumbs = [
  { name: "投資失敗録", url: "/" },
  { name: "比較", url: "/compare/" },
  { name: "追証なしFX口座 比較2026", url: "/compare/fx-no-margin-call/" },
];

// FAQ
const faqs = [
  {
    q: "「追証なし」って国内FXでも本当に可能？",
    a: "原則として国内FXは追証ありの設計です。ただしロスカット水準が高い（100%）口座を選ぶと、含み損が拡大する前に強制決済が走るため、追証が発生する確率を下げられます。スリッページで間に合わないリスクはゼロにはなりません。",
  },
  {
    q: "ロスカット50%と100%、どっちが安全？",
    a: "「安全」の定義によります。50%は損失を確定するまでの余裕が大きいですが、含み損は膨らみやすい。100%は早期に切られるので追証は起きにくいですが、本来なら戻ったかもしれない値動きでも損切りされます。短期売買と長期保有のどちらに比重を置くかで選び方が変わります。",
  },
  {
    q: "海外FX（XM・Exness等）の「ゼロカット」を使えば追証は本当にゼロ？",
    a: "海外FXのゼロカットは口座残高がマイナスになった分を業者が補填する仕組みで、原理的に追証は発生しません。ただし国内の金融商品取引法に基づく登録業者ではないため、トラブル時の救済制度（金融商品取引業者の信託保全等）の対象外。リスクの種類が違うだけで「安全」とは言えません。",
  },
  {
    q: "FXは結局やめた方がいい？",
    a: "本サイトは投資助言サイトではないので「やめろ」「やれ」とは書きません。ただし失敗体験を集めて整理した結論として、「生活費を投入してまでFXに賭ける合理性は薄い」と編集者個人としては考えています。インデックス積立など別ジャンルの選択肢と並べて比較した上で判断するのが現実的です。",
  },
  {
    q: "口座開設は1社だけで足りる？",
    a: "失敗体験のヒアリングを通じて見えてきたのは、メイン口座1社＋練習用に少額口座1社の合計2社くらいに留めるのが現実的、という観察結果です。複数口座で資金を分散すると管理が雑になり、ロスカット仕様の違いで予想外の挙動を起こすケースが多く報告されています。",
  },
];
---

<BaseLayout
  title={title}
  description={description}
  showQuickNav={false}
  pageType="article"
  articleMeta={{
    headline: title,
    category: "FX / 比較",
    datePublished: updatedAt,
    dateModified: updatedAt,
    author: "しら",
  }}
  breadcrumbs={breadcrumbs}
>
  <article class="pillar-page">
    <nav class="breadcrumb">
      <a href="/">トップ</a><span>›</span>
      <a href="/compare/">比較</a><span>›</span>
      <span>追証なしFX口座 比較2026</span>
    </nav>

    <header class="pillar-head">
      <span class="pillar-head__cat">FX 口座比較</span>
      <p class="pr-label" style="font-size:0.74rem;color:#8a8475;letter-spacing:0.06em;margin:0 0 10px;">※本ページにはプロモーション（広告）が含まれます</p>
      <h1 class="pillar-head__title">{title}</h1>
      <p class="pillar-head__lead">
        FXで「追証」が発生する仕組みを整理しつつ、ロスカット余裕度・最低取引単位・スプレッドで国内FX口座を観察した。<br />
        実際にロスカットが間に合わずに追証発生した失敗体験から学ぶ口座選びの観点を、編集者整理として残しておく。
      </p>
      <div class="pillar-head__meta">
        <span><strong>更新</strong>{updatedAt}</span>
        <span><strong>取り上げ数</strong>{fxItems.length}社</span>
        <span><strong>編集</strong>しら</span>
      </div>
    </header>

    <TopAffiliateBox
      pillars={topPillars}
      heading="先に読んでおくと整理しやすい"
      subLabel="BACKGROUND READING"
    />

    <AdSenseSlot slot="pillar-header" format="rectangle" />

    <section class="pillar-section">
      <h2 class="pillar-h2">この記事のスタンス</h2>
      <p>
        「追証なしFX」と検索したときに出てくる情報の多くは、海外FXのゼロカット仕様を勧める内容に偏っている。
        だけど海外FXは国内の金融商品取引法の登録外で、別のリスク（出金トラブル・規制変更）を抱え込むことになる。
      </p>
      <p>
        本記事は<strong>国内FXのまま「追証発生確率を下げる選び方」</strong>を整理するための比較記事。<br />
        ロスカット仕様・最低取引単位・スプレッドの3軸で、よく検討対象になる6社を編集者観察として並べた。
      </p>
      <p class="pillar-note">
        ※本記事は投資助言ではない。各社の最新スペックは公式サイトで必ず確認してから判断してください。
      </p>
    </section>

    <PillarCompareTable
      items={fxItems}
      caption="国内FX口座 6社の整理（編集者観察）"
      axesLabel="SELECTION AXES"
      axesNote="選定の軸：ロスカット水準（50%か100%か）・最低取引単位・USD/JPYスプレッド・サポート体制・学習コンテンツの有無"
    />

    <AdSenseSlot slot="pillar-middle" format="in-feed" />

    <section class="pillar-section">
      <h2 class="pillar-h2">「追証なし」を本当に避けるための3つの観点</h2>
      <ol class="pillar-list">
        <li>
          <strong>ロスカット水準が高い口座を選ぶ</strong>：100%系（外為どっとコム・LINE FX・マネーパートナーズ）の方が、含み損が膨らむ前に強制決済が走るので、追証発生確率を下げられる。
        </li>
        <li>
          <strong>最低取引単位が小さい口座で練習する</strong>：マネーパートナーズ100通貨・外為どっとコム/LINE FX 1,000通貨。1ポジションあたりのリスクが小さいので、追証ライン到達まで遥かに距離がある。
        </li>
        <li>
          <strong>レバレッジを最大に張らない</strong>：国内FXは25倍だけど、実効レバレッジを3〜5倍程度に抑えると、急変動の数百pipsを耐えられる範囲が広がる。
        </li>
      </ol>
      <p class="pillar-callout">
        この3つを組み合わせると、国内FXでも実質的に「追証なし」運用に近づく。<br />
        ただし、流動性が完全に消える瞬間（重要指標発表・週末ギャップ）はゼロにはできない、という前提で。
      </p>
    </section>

    <section class="pillar-failures">
      <div class="pillar-failures__head">
        <span class="pillar-failures__sub">REAL FAILURES</span>
        <h2 class="pillar-failures__title">この観点で「ロスカットが間に合わなかった」体験</h2>
      </div>
      <p class="pillar-failures__intro">
        スペックだけ見ると安全に見える口座でも、実際の急変動では追証が発生する。当サイトに集まった体験談から、ロスカット仕様と現実のズレを記録した記事を並べた。
      </p>
      <ul class="pillar-failures__list">
        {relatedFailures.map((r) => (
          <li>
            <a href={r.href}>
              <span class="pillar-failures__icon" aria-hidden="true"></span>
              <span class="pillar-failures__text">
                <strong>{r.title}</strong>
                <span>{r.meta}</span>
              </span>
              <span class="pillar-failures__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <AdSenseSlot slot="pillar-faq-before" format="rectangle" />

    <section class="pillar-faq">
      <div class="pillar-faq__head">
        <span class="pillar-faq__sub">FAQ</span>
        <h2 class="pillar-faq__title">よく届く質問</h2>
      </div>
      <div class="pillar-faq__list">
        {faqs.map((f, i) => (
          <details class="pillar-faq__item" open={i === 0}>
            <summary>
              <span class="pillar-faq__q-mark" aria-hidden="true">Q</span>
              <span class="pillar-faq__q-text">{f.q}</span>
            </summary>
            <div class="pillar-faq__a">
              <span class="pillar-faq__a-mark" aria-hidden="true">A</span>
              <p>{f.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <EndAffiliateMix
      sameCategory={endSameCategory}
      pillars={endPillars}
      sameCategoryLabel="REAL CASES"
      pillarsLabel="OTHER COMPARES"
      sameCategoryHeading="同じテーマの失敗体験を読む"
      pillarsHeading="関連する比較・解説"
    />

    <NewsletterCTA />

    <AdSenseSlot slot="pillar-footer" format="rectangle" />
  </article>
</BaseLayout>

<style>
  .pillar-page {
    max-width: 880px;
    margin: 0 auto;
    padding: 0 24px 60px;
  }
  .breadcrumb {
    max-width: 880px;
    margin: 20px auto 0;
    padding: 0 24px;
    font-size: 0.78rem;
    color: var(--c-ink-dim);
  }
  .breadcrumb a { color: var(--c-navy); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb span { margin: 0 6px; color: var(--c-gold); }

  .pillar-head {
    padding: 36px 0 28px;
    border-bottom: 2px solid var(--c-navy);
    margin-bottom: 32px;
  }
  .pillar-head__cat {
    display: inline-block;
    background: var(--c-gold);
    color: var(--c-navy-deep);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    padding: 5px 14px;
    border-radius: 2px;
    margin-bottom: 18px;
  }
  .pillar-head__title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3.6vw, 2rem);
    font-weight: 700;
    color: var(--c-ink);
    margin: 0 0 18px;
    line-height: 1.55;
    letter-spacing: 0.06em;
  }
  .pillar-head__lead {
    margin: 0 0 22px;
    font-size: 1rem;
    color: var(--c-ink-soft);
    line-height: 2;
  }
  .pillar-head__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 0.84rem;
    color: var(--c-ink-soft);
  }
  .pillar-head__meta strong {
    color: var(--c-ink-dim);
    margin-right: 8px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .pillar-section {
    margin: 42px 0;
  }
  .pillar-h2 {
    font-family: var(--font-serif);
    font-size: 1.36rem;
    font-weight: 700;
    color: var(--c-ink);
    letter-spacing: 0.08em;
    margin: 0 0 18px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--c-navy);
  }
  .pillar-section p {
    font-size: 0.98rem;
    line-height: 2.05;
    color: var(--c-ink);
    margin: 0 0 14px;
  }
  .pillar-section strong { color: var(--c-navy-deep); }
  .pillar-note {
