---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopAffiliateBox from "../../components/TopAffiliateBox.astro";
import PillarCompareTable from "../../components/PillarCompareTable.astro";
import EndAffiliateMix from "../../components/EndAffiliateMix.astro";
import NewsletterCTA from "../../components/NewsletterCTA.astro";
import AdSenseSlot from "../../components/AdSenseSlot.astro";

const title =
  "追証なしFX口座 比較2026 ─ 強制ロスカット仕様で選ぶ国内FX 6社の整理";
const description =
  "FXで「追証」が発生する仕組みを整理しつつ、ロスカット余裕度・最低取引単位・スプレッドで国内FX口座6社を観察。実際にロスカットが間に合わず追証発生した失敗体験から学ぶ口座選びの観点。";
const updatedAt = "2026-05-25";

// 関連解説（記事冒頭の TopAffiliateBox 用）
const topPillars = [
  {
    href: "/explain/loss-cut-mechanism/",
    title: "ロスカットの仕組み",
    subtitle: "「指定レートで切る」と「次の約定可能レートで切る」の違い",
    icon: "",
  },
  {
    href: "/explain/loss-cut-mechanism/",
    title: "追証はなぜ発生するか",
    subtitle: "スリッページ・流動性消失・口座規約の3要素",
    icon: "",
  },
];

// 6社比較データ（公式情報は各社サイトの最新値で要再確認・編集者観察として整理）
const fxItems = [
  {
    name: "DMM FX",
    tagline: "取引ツールとサポート体制が安定。10,000通貨単位で中規模以上向き。",
    badge: "編集者観察",
    specs: [
      { label: "ロスカット水準", value: "証拠金維持率 50%以下", highlight: true },
      { label: "最低取引単位", value: "10,000通貨" },
      { label: "USD/JPYスプレッド", value: "0.2銭（原則固定・例外あり）" },
      { label: "口座開設費", value: "無料" },
