---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopAffiliateBox from "../../components/TopAffiliateBox.astro";
import PillarCompareTable from "../../components/PillarCompareTable.astro";
import EndAffiliateMix from "../../components/EndAffiliateMix.astro";
import NewsletterCTA from "../../components/NewsletterCTA.astro";
import AdSenseSlot from "../../components/AdSenseSlot.astro";

const title =
  "【2026最新】資産運用EXPOに初心者が行ったらヤバい本当の理由 ─ Xトレンド分析＋構造解説";
const description =
  "2026年5月の資産運用EXPOがXでトレンド入り。X上に集まった来場者の証言と、編集者が運営構造から逆算で組み立てた「なぜ毎回ぼったくり化するのか」の答えを1記事で整理。初心者が代わりに進むべき3ステップも編集者整理として残した。";
const updatedAt = "2026-05-25";

const topPillars = [
  {
    href: "/explain/scam-detection-guide/",
    title: "投資詐欺の見抜き方",
    subtitle: "勧誘文言・出金条件・運営実態の見るべき箇所",
    icon: "",
  },
  {
    href: "/compare/fx-no-margin-call/",
    title: "追証なしFX口座 比較2026",
    subtitle: "EXPOよりも自分で口座を選んで小さく始める道筋",
    icon: "",
  },
];

// ネット証券3社（EXPO に行くより家でこっち、という代替案）
const netSecItems = [
  {
    name: "SBI証券",
    tagline: "国内ネット証券最大手。新NISA口座数・投信本数で頭ひとつ抜けている。",
