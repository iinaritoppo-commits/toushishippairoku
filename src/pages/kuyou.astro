---
import BaseLayout from "../layouts/BaseLayout.astro";

// 位牌メッセージ：戒名の核心を1行で。カード/モーメントとは別文章。
const ihaiList = [
  { sect: "FX 諸霊位", kaimyo: "指標発表院<br/>釈萬徹刹那 居士", name: "M.T 様", loss: "¥3,847,200", msg: "ロスカットを設定していた。それでも、間に合わなかった。", date: "2026.05.04" },
  { sect: "仮想通貨 諸霊位", kaimyo: "LINE直通霊感院<br/>釈啓盛退路 居士", name: "K.S 様", loss: "¥4,820,000", msg: "20年来の旧友からの誘いだった。", date: "2026.05.02" },
  { sect: "株式 諸霊位", kaimyo: "四連難平院<br/>釈弥阿深淵 居士", name: "Y.A 様", loss: "おおよそ¥280万", msg: "4回目を買った瞬間、引き返す道は閉じた。", date: "2026.04.30" },
  { sect: "不動産 諸霊位", kaimyo: "表面利回院<br/>釈乗法空室 大居士", name: "N.H 様", loss: "500〜700万円台", msg: "「家賃保証」の保証は、家賃額の保証ではなかった。", date: "2026.04.27" },
  { sect: "情報商材 諸霊位", kaimyo: "絶対勝法二度受講院<br/>釈徹翁授業 居士", name: "T.O 様", loss: "¥1,480,000", msg: "1年後、同じ販売者から、別の商材を買っていた。", date: "2026.04.24" },
  { sect: "FX 諸霊位", kaimyo: "ロスカット解除院<br/>釈律剋自爆 居士", name: "R.K 様", loss: "¥2,134,000", msg: "通知音をオフにしていた、それだけだった。", date: "2026.04.21" },
  { sect: "FX 諸霊位", kaimyo: "初陣全集中院<br/>釈花暦無常 信女", name: "H.K 様", loss: "¥182,500", msg: "「減るスピードに勝とう」と、本気で思っていた。", date: "2026.04.18" },
  { sect: "仮想通貨 諸霊位", kaimyo: "次は戻信院<br/>釈道和天井買付 居士", name: "D.W 様", loss: "¥3,180,000", msg: "上昇するたびに、目標値が、少し後ろにずれた。", date: "2026.04.15" },
];

// 次回合同供養日（毎月17日）を動的計算
// memory feedback_no_hardcoded_numbers.md 厳守：日付ハードコード禁止
const now = new Date();
const _y = now.getFullYear();
const _m = now.getMonth() + 1;
const _d = now.getDate();
let nextKuyouY = _y;
let nextKuyouM = _m;
if (_d > 17) {
  nextKuyouM = _m + 1;
  if (nextKuyouM > 12) { nextKuyouM = 1; nextKuyouY = _y + 1; }
}
const nextKuyouLabel = `${nextKuyouY}年${nextKuyouM}月17日（月命日）`;

---

<BaseLayout
  title="失敗供養所｜投資失敗録"
  description="届いた投資失敗の話を、ひとつずつ供養していく場所。戒名はAI命名、位号は損失額で変動。毎月17日の月命日に、その月集まった話をまとめてお焚き上げします。"
>

<section class="kuyou-section" id="section-kuyou">
  <div class="kuyou-head">
    <span class="kuyou-head__sub">SHIPPAI KUYOUJO</span>
    <h1 class="kuyou-head__title">失敗供養所</h1>
    <p class="kuyou-head__lead">届いた失敗の話を、ひとつずつ供養していく場所。<br/>毎月17日（月命日）に、その月集まった話をまとめてお焚き上げ。<br/><span style="color:#d8a55a;font-size:0.78rem;letter-spacing:0.16em">— 戒名はAI命名・位号は損失額で変動 —</span></p>
  </div>
  <div class="kuyou-inner">
    <div class="altar">
      <div class="altar__top">― 御 霊 前 ―</div>
      <div class="altar__name">投資失敗 諸霊位</div>

      <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <defs>
          <linearGradient id="waxG" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#5a3a18"/><stop offset="12%" stop-color="#a88450"/>
            <stop offset="35%" stop-color="#f0d8a4"/><stop offset="55%" stop-color="#fff8e0"/>
            <stop offset="78%" stop-color="#d8b87a"/><stop offset="100%" stop-color="#5a3a18"/>
          </linearGradient>
          <linearGradient id="waxTop" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#8a5a28"/><stop offset="60%" stop-color="#a8854a"/><stop offset="100%" stop-color="#f0d8a4"/>
          </linearGradient>
          <radialGradient id="glowG" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="rgba(255,180,80,0.55)"/><stop offset="55%" stop-color="rgba(255,140,42,0.18)"/><stop offset="100%" stop-color="rgba(255,140,42,0)"/>
          </radialGradient>
          <radialGradient id="flameOuterG" cx="50%" cy="80%" r="55%">
            <stop offset="0%" stop-color="#ffe4a0"/><stop offset="35%" stop-color="#ffaa3a"/>
            <stop offset="65%" stop-color="#ff7020"/><stop offset="100%" stop-color="rgba(220,60,20,0)"/>
          </radialGradient>
          <radialGradient id="flameMidG" cx="50%" cy="78%" r="50%">
            <stop offset="0%" stop-color="#fff5d0"/><stop offset="50%" stop-color="#ffd766"/><stop offset="100%" stop-color="rgba(255,215,102,0)"/>
          </radialGradient>
          <radialGradient id="flameCoreG" cx="50%" cy="78%" r="50%">
            <stop offset="0%" stop-color="#ffffff"/><stop offset="60%" stop-color="#fff8d8"/><stop offset="100%" stop-color="rgba(255,248,216,0)"/>
          </radialGradient>
          <filter id="flameBlur" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur stdDeviation="0.5"/>
          </filter>
        </defs>
      </svg>

      <div class="altar__candles">
        <div class="candle">
          <svg class="candle-svg" viewBox="0 0 60 140" xmlns="http://www.w3.org/2000/svg">
            <ellipse class="candle-glow" cx="30" cy="50" rx="34" ry="34" fill="url(#glowG)"/>
            <rect x="22" y="48" width="16" height="80" fill="url(#waxG)"/>
            <ellipse cx="30" cy="48.2" rx="8" ry="2.8" fill="url(#waxTop)"/>
            <ellipse cx="30" cy="48.2" rx="5.5" ry="1.6" fill="#3a2410" opacity="0.65"/>
            <path d="M 22 56 Q 18.5 65 20.5 80 Q 22 86 23 78 Q 24.5 66 22 56 Z" fill="url(#waxG)"/>
            <ellipse cx="30" cy="129" rx="14" ry="2.2" fill="rgba(0,0,0,0.55)"/>
            <line x1="30" y1="40" x2="30" y2="48" stroke="#1a0a05" stroke-width="1.3" stroke-linecap="round"/>
            <circle cx="30" cy="40" r="0.8" fill="#000"/>
            <g class="candle-flame">
              <ellipse cx="30" cy="32" rx="6.5" ry="14" fill="url(#flameOuterG)" filter="url(#flameBlur)"/>
              <ellipse cx="30" cy="34" rx="3.6" ry="9" fill="url(#flameMidG)"/>
              <ellipse cx="30" cy="36" rx="1.6" ry="4.8" fill="url(#flameCoreG)"/>
            </g>
          </svg>
        </div>
        <div class="candle">
          <svg class="candle-svg" viewBox="0 0 60 140" xmlns="http://www.w3.org/2000/svg">
            <ellipse class="candle-glow" cx="30" cy="50" rx="34" ry="34" fill="url(#glowG)"/>
            <rect x="22" y="48" width="16" height="80" fill="url(#waxG)"/>
            <ellipse cx="30" cy="48.2" rx="8" ry="2.8" fill="url(#waxTop)"/>
            <ellipse cx="30" cy="48.2" rx="5.5" ry="1.6" fill="#3a2410" opacity="0.65"/>
            <path d="M 22 58 Q 19 70 21.5 82 Q 23 86 24 78 Q 25 68 22 58 Z" fill="url(#waxG)"/>
            <ellipse cx="30" cy="129" rx="14" ry="2.2" fill="rgba(0,0,0,0.55)"/>
            <line x1="30" y1="40" x2="30" y2="48" stroke="#1a0a05" stroke-width="1.3" stroke-linecap="round"/>
            <circle cx="30" cy="40" r="0.8" fill="#000"/>
            <g class="candle-flame">
              <ellipse cx="30" cy="32" rx="6.5" ry="14" fill="url(#flameOuterG)" filter="url(#flameBlur)"/>
              <ellipse cx="30" cy="34" rx="3.6" ry="9" fill="url(#flameMidG)"/>
              <ellipse cx="30" cy="36" rx="1.6" ry="4.8" fill="url(#flameCoreG)"/>
            </g>
          </svg>
        </div>
        <div class="candle">
          <svg class="candle-svg" viewBox="0 0 60 140" xmlns="http://www.w3.org/2000/svg">
            <ellipse class="candle-glow" cx="30" cy="50" rx="34" ry="34" fill="url(#glowG)"/>
            <rect x="22" y="48" width="16" height="80" fill="url(#waxG)"/>
            <ellipse cx="30" cy="48.2" rx="8" ry="2.8" fill="url(#waxTop)"/>
            <ellipse cx="30" cy="48.2" rx="5.5" ry="1.6" fill="#3a2410" opacity="0.65"/>
            <path d="M 38 58 Q 41 68 40 80 Q 39 84 38 76 Q 36.5 68 38 58 Z" fill="url(#waxG)"/>
            <ellipse cx="30" cy="129" rx="14" ry="2.2" fill="rgba(0,0,0,0.55)"/>
            <line x1="30" y1="40" x2="30" y2="48" stroke="#1a0a05" stroke-width="1.3" stroke-linecap="round"/>
            <circle cx="30" cy="40" r="0.8" fill="#000"/>
            <g class="candle-flame">
              <ellipse cx="30" cy="32" rx="6.5" ry="14" fill="url(#flameOuterG)" filter="url(#flameBlur)"/>
              <ellipse cx="30" cy="34" rx="3.6" ry="9" fill="url(#flameMidG)"/>
              <ellipse cx="30" cy="36" rx="1.6" ry="4.8" fill="url(#flameCoreG)"/>
            </g>
          </svg>
        </div>
      </div>

      <div class="altar__incense">
        <div class="incense__bowl"></div>
        <div class="incense__sticks"><span></span><span></span><span></span></div>
        <div class="incense__smoke" id="incense-smoke">
          <div class="smoke__plume"></div><div class="smoke__plume"></div>
          <div class="smoke__plume"></div><div class="smoke__plume"></div>
        </div>
      </div>

      <div class="altar__counts">
        <div class="altar__count-cell">
          <div class="altar__count" id="altar-count-eternal">順次<span class="altar__count-suffix">追加</span></div>
          <div class="altar__count-label">永代供養</div>
        </div>
        <div class="altar__count-divider"></div>
        <div class="altar__count-cell">
          <div class="altar__count altar__count--shoukou" id="altar-count-shoukou">0<span class="altar__count-suffix">回</span></div>
          <div class="altar__count-label">あなたのお焼香</div>
        </div>
      </div>
      <div class="shoukou-controls">
        <button class="shoukou-btn" type="button" onclick="window.shoukou && window.shoukou()">
          <span></span>焼香する
        </button>
        <label class="sound-toggle">
          <input type="checkbox" id="sound-on" checked />
          <span class="sound-toggle__track"><span class="sound-toggle__thumb"></span></span>
          <span class="sound-toggle__label" id="sound-label">音 ON</span>
        </label>
      </div>
      <div class="shoukou-ack" id="shoukou-ack">— ボッ —</div>

      <div class="altar__next">
        次回 合同供養：<br/>
        <strong>{nextKuyouLabel}</strong><br/>
        その月に届いた話を、まとめて供養します。
      </div>
    </div>

    <div class="ihai-section">
      <div class="ihai-section__head">
        <span class="ihai-section__title">最近お焚き上げした失敗</span>
        <a class="ihai-section__more" href="#section-kuyou">永代供養スペースへ →</a>
      </div>
      <div class="ihai-grid">
        {ihaiList.map((i) => (
          <a href="#" class="ihai">
            <div class="ihai__sect">{i.sect}</div>
            <div class="ihai__kaimyo" set:html={i.kaimyo} />
            <div class="ihai__name">{i.name}</div>
            <div class="ihai__loss">{i.loss}</div>
            <p class="ihai__msg">{i.msg}</p>
            <div class="ihai__date">{i.date}</div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="submit-cta" id="section-submit" style="margin-top:48px">
  <div class="submit-cta__inner">
    <h2 class="submit-cta__title">あなたの失敗も、供養します</h2>
    <p class="submit-cta__lead">話すことで、終わらせられることがあります。投稿は匿名で構いません。</p>
    <a href="/submit/" class="submit-cta__btn">失敗を投稿する →</a>
  </div>
</section>

</BaseLayout>
