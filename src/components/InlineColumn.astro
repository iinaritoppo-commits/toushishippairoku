---
// 本文中の「ここに注意」コラム。心理学・行動経済学の知識補足＋書籍アフィリ
// 本文中盤に1コラムだけ配置することを想定（YMYL影響を最小化）
interface BookLink {
  title: string;
  href: string;
  note?: string;
}
interface Props {
  title: string;
  body: string; // HTML可
  book?: BookLink;
  variant?: "default" | "warning";
}
const { title, body, book, variant = "default" } = Astro.props;
---
<aside class={`inline-col inline-col--${variant}`} aria-label={`関連知識：${title}`}>
  <div class="inline-col__head">
    <span class="inline-col__mark" aria-hidden="true"></span>
    <span class="inline-col__label">関連知識</span>
    <strong class="inline-col__title">{title}</strong>
  </div>
  <div class="inline-col__body" set:html={body} />
  {book && (
    <a class="inline-col__book" href={book.href} rel="sponsored noopener" target="_blank">
      <span class="inline-col__book-icon" aria-hidden="true"></span>
      <span class="inline-col__book-text">
        <span class="inline-col__book-title">{book.title}</span>
        {book.note && <span class="inline-col__book-note">{book.note}</span>}
      </span>
      <span class="inline-col__book-arrow" aria-hidden="true">↗</span>
    </a>
  )}
</aside>

<style>
  .inline-col {
    margin: 32px 0;
    padding: 18px 22px 20px;
    background: #fcfaf3;
    border: 1px solid #e6dfc7;
    border-left: 4px solid var(--c-gold);
    border-radius: 3px;
    position: relative;
  }
  .inline-col--warning {
    background: var(--c-warn-bg);
    border-color: var(--c-warn-border);
    border-left-color: #c0962a;
  }
  .inline-col__head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }
  .inline-col__mark {
    color: var(--c-gold);
    font-size: 1.1rem;
    line-height: 1;
    font-family: var(--font-serif);
  }
  .inline-col__label {
    font-size: 0.66rem;
    letter-spacing: 0.32em;
    color: var(--c-gold);
    font-weight: 800;
  }
  .inline-col__title {
    font-family: var(--font-serif);
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--c-ink);
    letter-spacing: 0.06em;
  }
  .inline-col__body {
    font-size: 0.94rem;
    color: var(--c-ink-soft);
    line-height: 1.95;
    margin: 0;
  }
  .inline-col__body :global(p) { margin: 0 0 10px; }
  .inline-col__body :global(p:last-child) { margin-bottom: 0; }
  .inline-col__body :global(strong) { color: var(--c-ink); }

  .inline-col__book {
    display: grid;
    grid-template-columns: 24px 1fr 18px;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
    padding: 12px 14px;
    background: #ffffff;
    border: 1px solid var(--c-line);
    text-decoration: none;
    color: var(--c-ink);
    transition: all 0.15s ease;
  }
  .inline-col__book:hover {
    border-color: var(--c-navy);
    background: #fbfaf6;
    text-decoration: none;
  }
  .inline-col__book-icon {
    font-size: 1.1rem;
    line-height: 1;
  }
  .inline-col__book-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .inline-col__book-title {
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--c-ink);
  }
  .inline-col__book-note {
    font-size: 0.74rem;
    color: var(--c-ink-dim);
    letter-spacing: 0.04em;
  }
  .inline-col__book-arrow {
    color: var(--c-gold);
    font-weight: 700;
    font-size: 0.96rem;
  }
  .inline-col__book:hover .inline-col__book-arrow { color: var(--c-navy); }

  @media (max-width: 540px) {
    .inline-col { padding: 16px 16px 18px; }
    .inline-col__title { font-size: 0.96rem; }
    .inline-col__body { font-size: 0.9rem; }
    .inline-col__book { grid-template-columns: 22px 1fr 16px; gap: 10px; padding: 10px 12px; }
    .inline-col__book-title { font-size: 0.84rem; }
  }
</style>
